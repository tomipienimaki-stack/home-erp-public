# Supabase: projektin URL ja julkinen anon-avain (Project Settings → API).
# Vercelissä riittää SUPABASE_URL ja SUPABASE_ANON_KEY ilman VITE_-etuliitettä.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Vain paikalliseen kehitykseen: ohittaa kirjautumisen. ÄLÄ KOSKAAN aseta tuotannossa.
VITE_AUTH_DISABLED=false
