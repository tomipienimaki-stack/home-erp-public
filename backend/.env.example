PORT=3001
CORS_ORIGIN=http://localhost:5173

# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_or_eyJ... (backend only, never expose)
# Valinnainen: omistajan Supabase-käyttäjän UID. Ilman tätä omistaja luodaan sovelluksessa ensimmäisellä käynnistyksellä.
SINGLE_USER_ID=

# Anthropic — for AI meal plan generation
ANTHROPIC_API_KEY=sk-ant-...

# Auth — every API request requires a Supabase JWT of SINGLE_USER_ID or this API key.
# Static API key for the MCP server (sent as X-Api-Key). Leave empty to disable the API-key route.
HOME_ERP_API_TOKEN=
# Valinnainen: vain jos ajat /cron/*-reitit Vercel Cronilla. Ilman tätä reitit palauttavat 401,
# ja päivän ajot käynnistyvät sovelluksen käytöstä.
CRON_SECRET=
# Local development only: skips all authentication. NEVER set to true in production.
AUTH_DISABLED=false

# Valinnainen: migraatioiden automaattinen ajo (npm run migrate). Vercelin Supabase-integraatio asettaa tämän.
POSTGRES_URL=
