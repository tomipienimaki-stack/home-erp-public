PORT=3001
CORS_ORIGIN=http://localhost:5173

# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_or_eyJ... (backend only, never expose)
SINGLE_USER_ID=your-auth-uid-here

# Anthropic — for AI meal plan generation
ANTHROPIC_API_KEY=sk-ant-...

# Auth — every API request requires a Supabase JWT of SINGLE_USER_ID or this API key.
# Static API key for the MCP server (sent as X-Api-Key). Leave empty to disable the API-key route.
HOME_ERP_API_TOKEN=
# Vercel Cron: Vercel lähettää tämän `Authorization: Bearer`-otsakkeessa /cron/*-reiteille.
# Ilman tätä cron-reitit palauttavat aina 401. Aseta Vercel-projektin ympäristömuuttujiin.
CRON_SECRET=
# Local development only: skips all authentication. NEVER set to true in production.
AUTH_DISABLED=false
